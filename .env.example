# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and never committed.

# Google AI Studio key (https://aistudio.google.com/app/apikey).
# Used by the orchestrator when perception.vlm.provider == "gemini".
GEMINI_API_KEY=

# Anthropic API key (https://console.anthropic.com).
# Used by the orchestrator when perception.vlm.provider == "claude".
ANTHROPIC_API_KEY=

# OpenAI API key.
# Used when perception.vlm.provider == "openai".
OPENAI_API_KEY=
